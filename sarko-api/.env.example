PORT=8080
DATABASE_URL=postgres://sarko:sarko@localhost:5455/sarko?sslmode=disable
# At least 32 bytes, enforced at startup. This signs 30-day player tokens, so
# a short secret can be brute-forced offline from any single issued token and
# every player id becomes forgeable. Generate one, do not type one.
JWT_SECRET=change-me-32-chars-minimum-secret
RAID_TTL=12m
PENDING_TTL=60s
# Added to RAID_TTL when a raid is confirmed. This is slack for a slow result
# submission, not extra play time — the client's in-raid timer must still be
# strictly shorter than RAID_TTL.
GRACE_BUFFER=2m
